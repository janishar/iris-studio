# build output
/iris-studio
/iris-studio.exe
/dist/
/.gocache/
__debug_bin*

# what helm dev keeps for a checkout — the store, this studio's data
# directory, its sessions and every take in them — and what scripts/run.sh
# makes itself. The studio writes nothing into the repository any more.
/.helm/
/.cache/
/iris-studio.bin
# where sessions used to live, before helmstudio started saying where. A
# checkout from before that still has one; nothing reads it.
/sessions/

# iris.c build artifacts (in case the submodule is built in place)
iris.c/*.o
iris.c/*.mps.o
iris.c/iris
iris.c/libiris.a
iris.c/iris_shaders_source.h

# editor/OS cruft
.DS_Store
